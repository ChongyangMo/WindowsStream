[connection]
mode=listen
bind_host=127.0.0.1
port=17413
token=@stream_key@

[video]
resolution=limited
max_width=1920
max_height=1080
fps=30
bitrate_mbps=12

[permissions]
clipboard=0
file_drag=1
exclusive_mouse=1
remote_files_ini=..\remote-files.ini

[administrator_permissions]
clipboard=1
file_drag=1

[updates]
enabled=0

[background]
autostart=1
relay_autostart=1
autostart_ini=..\startup.ini
tray=1
start_hidden=0
keep_awake=1
disable_manual_lock=0
watchdog=1
idle_pulse=1

[proxy]
enabled=0
